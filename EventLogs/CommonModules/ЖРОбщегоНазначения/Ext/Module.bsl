Процедура СоздатьТаблицыЖРНаСервереБД(Соединение)
	
	АДОКоманда = АДОКомандаПоУмолчанию(Соединение);
	АДОКоманда.CommandText = ТекстЗапросаСозданияТаблицБД();
	АДОКоманда.Execute();
КонецПроцедуры

Функция ТекстЗапросаСозданияТаблицБД()

	СтрокаЗапроса = "CREATE TABLE IF NOT EXISTS " + ИмяТаблицы() +  " (
	|	Id bigserial PRIMARY KEY,
	|	ИдентификаторИБ text,
	|	Уровень  text,
	|	Дата timestamp,
	|	Пользователь text,
	|	ИмяПользователя text,
	|	Компьютер text,
	|	ИмяПриложения text,
	|	Событие text,
	|	ПредставлениеСобытия text,
	|	Комментарий text,
	|	Метаданные text,
	|	ПредставлениеМетаданных text,
	|	Данные text,
	|	ПредставлениеДанных text,
	|   ПредставлениеПриложения text,
	|	СтатусТранзакции text,
	|	Транзакция text,
	|	Сеанс integer,
	|   Соединение integer,
	|   РабочийСервер text,
	|	ОсновнойIPПорт integer,
	|	ВспомогательныйIPПорт text,
	|	РазделениеДанныхСеанса text,
	|	ПредставлениеРазделенияДанныхСеанса text);
	
	|	CREATE INDEX IF NOT EXISTS ix_database_id
	|    ON " + ИмяТаблицы() + " USING hash
	|    (ИдентификаторИБ COLLATE pg_catalog.default)
	|    TABLESPACE pg_default;


	|CREATE INDEX IF NOT EXISTS ix_date
	|    ON " + ИмяТаблицы() + " USING btree
	|    (Дата ASC NULLS LAST)
	|    WITH (deduplicate_items=False)
	|    TABLESPACE pg_default;


	|CREATE INDEX IF NOT EXISTS ix_event
	|    ON " + ИмяТаблицы() + " USING btree
	|    (ПредставлениеСобытия COLLATE pg_catalog.default ASC NULLS LAST)
	|    INCLUDE(Событие)
	|    WITH (deduplicate_items=True)
	|    TABLESPACE pg_default;


	|CREATE INDEX IF NOT EXISTS ix_level
	|    ON " + ИмяТаблицы() + " USING btree
	|    (Уровень COLLATE pg_catalog.default ASC NULLS LAST)
	|    WITH (deduplicate_items=False)
	|    TABLESPACE pg_default;


	|CREATE INDEX IF NOT EXISTS ix_metadata
	|    ON " + ИмяТаблицы() + " USING btree
	|    (ПредставлениеМетаданных COLLATE pg_catalog.default ASC NULLS LAST)
	|    INCLUDE(Метаданные)
	|    WITH (deduplicate_items=True)
	|    TABLESPACE pg_default;


	|CREATE INDEX IF NOT EXISTS ix_username
	|    ON " + ИмяТаблицы() + " USING btree
	|    (ИмяПользователя COLLATE pg_catalog.default ASC NULLS LAST)
	|    WITH (deduplicate_items=True)
	|    TABLESPACE pg_default;";
	
	Возврат СтрокаЗапроса;
КонецФункции

Функция УстановитьСтрокуДанных(Знач Данные)
	
	ДанныеСтрокой = ЗначениеВСтрокуВнутр(Данные);
	УточненнаяСтрока = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыXML(ДанныеСтрокой);
	
	Если ДанныеСтрокой <> УточненнаяСтрока Тогда
		Попытка
			ЗначениеИзСтрокиВнутр(УточненнаяСтрока);
			ДанныеСтрокой = УточненнаяСтрока;
		Исключение
			ДанныеСтрокой = "";
		КонецПопытки;
	КонецЕсли;
	Возврат ДанныеСтрокой;
	
КонецФункции

Функция ЗаполнениеСтрокиВставки(СтрокаЖурнала, Знач СтрокаЗаписи)

	// Экранируем для Postgre одинарные кавычки и слеши
	КоличествоКолонок = СтрокаЖурнала.Владелец().Колонки.Количество() - 1;
	Для Индекс=0 По КоличествоКолонок Цикл
	//Для Каждого Значение Из СтрокаЖурнала Цикл
		СтрокаЖурнала[Индекс] = СтрЗаменить(СтрокаЖурнала[Индекс], Символ(39), Символ(34));
		СтрокаЖурнала[Индекс] = СтрЗаменить(СтрокаЖурнала[Индекс], "\", "\\");
		СтрокаЖурнала[Индекс] = СтрЗаменить(СтрокаЖурнала[Индекс], Символы.НПП, "");
	КонецЦикла;

	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ИдентификаторИБ", ЖРСлужебныйСервер.ИдентификаторИнформационнойБазы());
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Уровень", СтрокаЖурнала.Уровень);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Дата", Формат(СтрокаЖурнала.Дата, "ДФ=гггг-ММ-дд чч:мм:сс"));
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Пользователь", СтрокаЖурнала.Пользователь);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ИмяПользователя", СтрокаЖурнала.ИмяПользователя);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Компьютер", СтрокаЖурнала.Компьютер);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ИмяПриложения", СтрокаЖурнала.ИмяПриложения);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Событие", СтрокаЖурнала.Событие);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ПредставлениеСобытия", СтрокаЖурнала.ПредставлениеСобытия);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Комментарий", СтрокаЖурнала.Комментарий);
	Если ТипЗнч(СтрокаЖурнала.Метаданные) = Тип("Массив") Тогда
		СтрокаЖурналаМетаданные = СтрСоединить(СтрокаЖурнала.Метаданные, "| ");
	Иначе
		СтрокаЖурналаМетаданные = Строка(СтрокаЖурнала.Метаданные);
	КонецЕсли;
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Метаданные", Строка(СтрокаЖурналаМетаданные));
	Если ТипЗнч(СтрокаЖурнала.ПредставлениеМетаданных) = Тип("Массив") Тогда
		ПредставлениеМетаданных = СтрСоединить(СтрокаЖурнала.ПредставлениеМетаданных, "| ");
	Иначе
		ПредставлениеМетаданных = СтрокаЖурнала.ПредставлениеМетаданных;
	КонецЕсли;	
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ПредставлениеМетаданных", ПредставлениеМетаданных);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Данные", ЖРСлужебныйСервер.ЗначениеВСтрокуXML(СтрокаЖурнала.Данные));
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ПредставлениеДанных", СтрокаЖурнала.ПредставлениеДанных);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ПредставлениеПриложения", СтрокаЖурнала.ПредставлениеПриложения);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#СтатусТранзакции", Строка(СтрокаЖурнала.СтатусТранзакции));
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Транзакция", СтрокаЖурнала.Транзакция);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Сеанс", ?(Формат(СтрокаЖурнала.Сеанс, "ЧГ=0")="",0, Формат(СтрокаЖурнала.Сеанс, "ЧГ=0")));
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#Соединение", Формат(СтрокаЖурнала.Соединение, "ЧН="));
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#РабочийСервер", СтрокаЖурнала.РабочийСервер);
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ОсновнойIPПорт", Формат(СтрокаЖурнала.ОсновнойIPПорт, "ЧН="));
	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ВспомогательныйIPПорт", СтрокаЖурнала.ВспомогательныйIPПорт);
	Если СтрНайти(СтрокаЗаписи, "#РазделениеДанныхСеанса") <> 0 Тогда
		СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#РазделениеДанныхСеанса", ЖРСлужебныйСервер.ЗначениеВСтрокуXML(СтрокаЖурнала.РазделениеДанныхСеанса));
    	СтрокаЗаписи = СтрЗаменить(СтрокаЗаписи, "#ПредставлениеРазделенияДанныхСеанса", стрСоединить(СтрокаЖурнала.ПредставлениеРазделенияДанныхСеанса, "| "));
	КонецЕсли;
	Возврат СтрокаЗаписи;
КонецФункции

Функция ТекстЗапросаВставкиДанныхЖурнала(СобытияЖурнала)
	СтрокаЗапроса = "INSERT INTO " + ИмяТаблицы() +  " (
	|	ИдентификаторИБ,	Уровень, Дата, Пользователь, ИмяПользователя, Компьютер, ИмяПриложения, Событие,
	|	ПредставлениеСобытия, Комментарий, Метаданные, ПредставлениеМетаданных, Данные, ПредставлениеДанных,
	|   ПредставлениеПриложения, СтатусТранзакции,	Транзакция, Сеанс, Соединение, РабочийСервер,
	|	ОсновнойIPПорт, ВспомогательныйIPПорт";
	
	СтрокаЗаписи = "('#ИдентификаторИБ', '#Уровень', '#Дата', '#Пользователь', '#ИмяПользователя', '#Компьютер', 
	|'#ИмяПриложения', '#Событие', '#ПредставлениеСобытия', '#Комментарий', '#Метаданные', 
	|'#ПредставлениеМетаданных', '#Данные', '#ПредставлениеДанных', '#ПредставлениеПриложения', '#СтатусТранзакции',
	|'#Транзакция', '#Сеанс', '#Соединение', '#РабочийСервер', '#ОсновнойIPПорт', '#ВспомогательныйIPПорт'";
	
	Если СобытияЖурнала.Колонки.Найти("РазделениеДанныхСеанса") <> Неопределено Тогда
		СтрокаЗапроса = СтрокаЗапроса + ", РазделениеДанныхСеанса"; 
	    СтрокаЗаписи = СтрокаЗаписи + ", '#РазделениеДанныхСеанса'";
	КонецЕсли;
	
	Если СобытияЖурнала.Колонки.Найти("ПредставлениеРазделенияДанныхСеанса") <> Неопределено Тогда
		СтрокаЗапроса = СтрокаЗапроса + ", 'ПредставлениеРазделенияДанныхСеанса'"; 
	    СтрокаЗаписи = СтрокаЗаписи + ", '#ПредставлениеРазделенияДанныхСеанса'";
	КонецЕсли;
	СтрокаЗапроса = СтрокаЗапроса + ") VALUES "; 
	СтрокаЗаписи = СтрокаЗаписи + ")";
	
	СтрокаЗначений = "";
	Для Каждого Событие Из СобытияЖурнала Цикл
		СтрокаВставки = ЗаполнениеСтрокиВставки(Событие, СтрокаЗаписи);
		СтрокаЗначений = СтрокаЗначений + СтрокаВставки + ","; 
	КонецЦикла;
	СтрокаЗначений = Лев(СтрокаЗначений, СтрДлина(СтрокаЗначений) - 1);
	СтрокаЗапроса = СтрокаЗапроса + СтрокаЗначений;
	Возврат СтрокаЗапроса;
КонецФункции

// Возвращает таблицу значений выгруженных записей из журнала регистрации.
// Параметры:
//	Отбор - см. ВыгрузитьЖурналРегистрации
//	КоличествоСобытий - см. ВыгрузитьЖурналРегистрации
Функция СобытияЖурналаРегистрации(Отбор, КоличествоСобытий = 0)

	Если ПроверкаДатВОтборе(Отбор) Тогда
		Журнал = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(Журнал, Отбор, , , КоличествоСобытий);
		Возврат Журнал;
	Иначе
		ВызватьИсключение НСтр("ru = 'Некорректно заданы условия отбора журнала регистрации. 
								|Дата начала больше даты окончания.';
								|en = 'Invalid event log filter settings. 
								|The start date is later than the end date.'");
	КонецЕсли;
КонецФункции

// Проверка дат в отборе
// Отбор - Структура
Функция ПроверкаДатВОтборе(Отбор)
	ДатаНачала    = Неопределено;
	ДатаОкончания = Неопределено;
	ДатыОтбораУказаны = Отбор.Свойство("ДатаНачала", ДатаНачала) 
		И Отбор.Свойство("ДатаОкончания", ДатаОкончания)
		И ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания);
		
	Если ДатыОтбораУказаны И ДатаНачала > ДатаОкончания Тогда
		Возврат Ложь;	
	Иначе
		Возврат Истина;
	КонецЕсли;
КонецФункции

// Преобразует список значений отбора в строку условия для Postgres
// Параметры:
//		Отбор - СписокЗначений или Структура
Функция ОтборВСтрокуУсловия(Отбор)
	
	СтрокаУсловия = "";
	СтруктураОтбор = Новый Структура;
	Если ТипЗнч(Отбор) = Тип("СписокЗначений") Тогда
		Для Каждого ЭлементСписка Из Отбор Цикл
			СтруктураОтбор.Вставить(ЭлементСписка.Представление, ЭлементСписка.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Отбор) = Тип("Структура") Тогда
		СтруктураОтбор = Отбор;
	КонецЕсли;

	Если ПроверкаДатВОтборе(СтруктураОтбор) Тогда
		СтрокаУсловия = СтрШаблон(" AND Дата>= '%1' AND Дата<='%2'", 
				Формат(СтруктураОтбор.ДатаНачала, "ДФ=гггг-ММ-дд чч:мм:сс"), 
				Формат(СтруктураОтбор.ДатаОкончания, "ДФ=гггг-ММ-дд чч:мм:сс"));
	Иначе
		ВызватьИсключение НСтр("ru = 'Некорректно заданы условия отбора журнала регистрации. Дата начала больше даты окончания.';
						|en = 'Invalid event log filter settings. The start date is later than the end date.'");
	КонецЕсли;
	
	СтрокаУсловия = СтрокаУсловия + ПоказательОтбораВСтрокуУсловия("Уровень", СтруктураОтбор);
	СтрокаУсловия = СтрокаУсловия + ПоказательОтбораВСтрокуУсловия("Пользователи", СтруктураОтбор);
	СтрокаУсловия = СтрокаУсловия + ПоказательОтбораВСтрокуУсловия("Компьютеры", СтруктураОтбор);
	СтрокаУсловия = СтрокаУсловия + ПоказательОтбораВСтрокуУсловия("События", СтруктураОтбор);
	СтрокаУсловия = СтрокаУсловия + ПоказательОтбораВСтрокуУсловия("Приложения", СтруктураОтбор);
	СтрокаУсловия = СтрокаУсловия + ПоказательОтбораВСтрокуУсловия("Метаданные", СтруктураОтбор);
	СтрокаУсловия = СтрокаУсловия + ПоказательОтбораВСтрокуУсловия("Данные", СтруктураОтбор);
	СтрокаУсловия = СтрокаУсловия + ПоказательОтбораВСтрокуУсловия("ПредставлениеДанных", СтруктураОтбор);
	
	Комментарий = Неопределено;
	Если СтруктураОтбор.Свойство("Комментарий", Комментарий) И ЗначениеЗаполнено(Комментарий) Тогда
		СтрокаУсловия = СтрокаУсловия + " AND (Комментарий ILIKE " + "'%" + Комментарий + "%')"; 
	КонецЕсли;

	СтрокаПоиска = Неопределено;
	Если СтруктураОтбор.Свойство("СтрокаПоиска", СтрокаПоиска) И ЗначениеЗаполнено(СтрокаПоиска) Тогда
		СтрокаПоиска = СтруктураОтбор.СтрокаПоиска;
		Если СтрДлина(СтрокаПоиска) > 2 Тогда
			СтрокаУсловия = СтрокаУсловия + " AND (Компьютер ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR ИмяПриложения ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR ПредставлениеПриложения ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR Событие ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR ПредставлениеСобытия ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR Комментарий ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR Метаданные ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR ПредставлениеМетаданных ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR ПредставлениеДанных ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR СтатусТранзакции ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR Транзакция ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR РабочийСервер ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR РазделениеДанныхСеанса ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR ПредставлениеРазделенияДанныхСеанса ILIKE '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR Сеанс = '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR Соединение = '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + " OR ОсновнойIPПорт = '%" + СтрокаПоиска + "%'";
			СтрокаУсловия = СтрокаУсловия + ")";	
		ИначеЕсли СтрДлина(СтрокаПоиска) < 3 И СтрДлина(СтрокаПоиска) > 0 Тогда
			ВызватьИсключение НСтр("ru = 'Строка поиска должна быть не менее 3-х символов.';
								|en = 'The search string must be at least 3 characters long.'");
		КонецЕсли;
	КонецЕсли;
	
	СтрокаУсловия = СтрокаУсловия + " ORDER BY Дата";	
	КоличествоЗаписей = Неопределено;
	Если СтруктураОтбор.Свойство("КоличествоЗаписей", КоличествоЗаписей) И КоличествоЗаписей > 0 Тогда
		СтрокаУсловия = СтрокаУсловия + СтрШаблон(" LIMIT %1", Формат(КоличествоЗаписей, "ЧГ=0"));
	КонецЕсли;
	Возврат СтрокаУсловия;
		
КонецФункции

Функция ПоказательОтбораВСтрокуУсловия(Показатель, Отбор)
	СоответствиеПоказателей = Новый Соответствие;
	// Ключ  как указано в отборе, значение - имя поля в таблице
	СоответствиеПоказателей.Вставить("Пользователи", "Пользователь");
	СоответствиеПоказателей.Вставить("Компьютеры", "Компьютер");
	СоответствиеПоказателей.Вставить("События", "Событие");
	СоответствиеПоказателей.Вставить("Приложения", "ИмяПриложения");
	СоответствиеПоказателей.Вставить("Уровень", "Уровень");
	СоответствиеПоказателей.Вставить("Метаданные", "Метаданные");
	СоответствиеПоказателей.Вставить("Данные", "Данные");
	СоответствиеПоказателей.Вставить("ПредставлениеДанных", "ПредставлениеДанных");

	Значение = Неопределено;
	СтрокаУсловия = "";
	Если Отбор.Свойство(Показатель, Значение) И ЗначениеЗаполнено(Значение) Тогда
		СтрокаУсловия = " AND (";
		Для Каждого Элемент Из Значение Цикл
			СтрокаУсловия = СтрокаУсловия + СтрШаблон("%1='%2' OR ", СоответствиеПоказателей[Показатель] , Элемент.Значение);
		КонецЦикла;
		СтрокаУсловия = Сред(СтрокаУсловия, 1 , СтрДлина(СтрокаУсловия) - 4);
		СтрокаУсловия = СтрокаУсловия + ")";
	КонецЕсли;
	Возврат СтрокаУсловия;
КонецФункции

Функция СтрокаУсловияПоУмолчанию()
	Возврат СтрШаблон("Where ИдентификаторИБ='%1'", ЖРСлужебныйСервер.ИдентификаторИнформационнойБазы());
КонецФункции

#КонецОбласти

// Уровень (Level) - тип УровеньЖурналаРегистрации;
//Дата (Date) - тип Дата;
//Пользователь (User) - идентификатор пользователя, тип УникальныйИдентификатор;
//Компьютер (Computer) - имя компьютера, тип Строка;
//ИмяПриложения (ApplicationName) - имя приложения, тип Строка;
//Событие (Event ) - имя события, тип Строка;
//Комментарий (Comment) - комментарий, тип Строка;
//Метаданные (Metadata) - имя объекта метаданных, тип Строка; 
//	для событий "Доступ. Доступ" и "Доступ. Отказ в доступе" в этой колонке может содержаться 
//	массив имен объектов метаданных, тип Массив;
//Данные (Data) - данные, произвольного типа, в зависимости от события;
//ПредставлениеДанных (DataPresentation) - представление данных, тип Строка;
//ИмяПользователя (UserName) - имя пользователя, тип Строка;
//ПредставлениеПриложения (ApplicationPresentation) - представление имени приложения, тип Строка;
//ПредставлениеСобытия (EventPresentation) - представление события, тип Строка;
//ПредставлениеМетаданных (MetadataPresentation) - представление объекта метаданных; тип Строка; 
//	для событий "Доступ. Доступ" и "Доступ. Отказ в доступе" в этой колонке может содержаться 
//	массив представлений объектов метаданных, тип Массив;
//СтатусТранзакции (TransactionStatus) - статус транзакции, тип СтатусТранзакцииЗаписиЖурналаРегистрации;
//Транзакция (TransactionID) - представление транзакции, тип Строка;
//Сеанс (Session) - номер сеанса, тип Число;
//Соединение (Connection) - номер соединения, тип Число;
//РабочийСервер (ServerName) - имя рабочего сервера, тип Строка;
//ОсновнойIPПорт (Port) - номер основного IP-порта, тип Число;
//ВспомогательныйIPПорт (SyncPort) - номер вспомогательного IP-порта, тип Строка;
//РазделениеДанныхСеанса (SessionDataSeparation) - Структура с элементами, имена которых соответствуют 
//	именам общих реквизитов, разделяющих данные, а значения - значениям этих общих реквизитов;
//ПредставлениеРазделенияДанныхСеанса (SessionDataSeparationPresentation) - 
//	Массив строк вида: <представление общего реквизита>: <представление значения общего реквизита>.
