Процедура ПолучитьСписокЗначенийСвойстваВФоне(СтруктураПараметров, АдресХранилища) Экспорт
	
	Соединение = Неопределено;
	СтруктураПараметров.Свойство("Соединение", Соединение);
	ОтбираемыйПараметр = СтруктураПараметров.ОтбираемыйПараметр;
	МассивЗначенийСвойства = МассивЗначенийСвойстваВЖурналеРегистрации(ОтбираемыйПараметр, Соединение);
	Результат = Новый Структура;
	Результат.Вставить("МассивЗначенийСвойства", МассивЗначенийСвойства);
