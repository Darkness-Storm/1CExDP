//Параметры:
//	ОтбираемыйПараметр - Строка - имя колонки в таблице
//	Соединение = СправочникСсылка.ЖРСоединения
//
// Возвращаемое значение:
//	Массив - массив сгруппированных значений из колонки в таблице
Функция МассивЗначенийСвойстваВЖурналеРегистрации(ОтбираемыйПараметр, Соединение = Неопределено)  Экспорт
	МассивЗначенийСвойства = Новый Массив;
	Если Соединение = Неопределено Тогда
		АДОСоединение = ПодключениеПоУмолчанию();
	Иначе
		АДОСоединение = ПодключениеADODB(Соединение);
	КонецЕсли;
	АДОНаборЗаписей = АДОРекордСет();
	АДОКоманда = АДОКомандаПоУмолчанию(АДОСоединение);
	АДОКоманда.CommandText = СтрШаблон("SELECT %1 FROM %2 %3 GROUP BY %1", 
		ОтбираемыйПараметр, 
		ИмяТаблицы(), 
		СтрокаУсловияПоУмолчанию()
	);
	Попытка
		АДОНаборЗаписей = АДОКоманда.Execute();
	Исключение
		ЗаписьЖурналаРегистрации("СписокЗначенийСвойстваВЖурналеРегистрации", 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.ОбщиеМодули.ЖРОбщегоНазначения, 
			ОписаниеОшибки(),
			АДОКоманда.CommandText
		);
		Возврат МассивЗначенийСвойства;
	КонецПопытки;
	
	Пока АДОНаборЗаписей.EOF = 0 Цикл
		МассивЗначенийСвойства.Добавить(АДОНаборЗаписей.Fields(ОтбираемыйПараметр).Value);
		АДОНаборЗаписей.MoveNext();
	КонецЦикла;
	АДОНаборЗаписей.Close();
	АДОСоединение.Close();
	Возврат МассивЗначенийСвойства;
	
КонецФункции

