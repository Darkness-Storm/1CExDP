#Область ПрограммныйИнтерфейс

//Параметры:
//	ТекстКоманды - Строка - текст sql запроса
//	Соединение - СправочникСсылка.ЖРСоединения
Процедура ВыполнитьКомандуНаСервере(Знач ТекстКоманды, Соединение = Неопределено) Экспорт
	АДОСоединение = ПодключениеПоУмолчанию(Соединение);
	АДОКоманда = АДОКомандаПоУмолчанию(АДОСоединение);
	АДОКоманда.CommandTimeout = 5000;
	АДОКоманда.CommandText = ТекстКоманды; 
	АДОКоманда.Execute();
	АДОСоединение.Close();
КонецПроцедуры

#Область ЗаписьДанных

// Выгрузка журнала регистрации в фоновом процессе
// Параметры:
//		СтруктураПараметров - Структура:
//								Соединение - Справочники.ЖРСоединения
//								ДатаНачала, ДатаОкончания
//		АдресХранилища - адрес во временном хранилище
// Возвращаемое значение: Структура -
//		ЗаписаноВБД - количество записей успешно внесенных в БД.
//		КоличествоЗаписейВЖурнале - количество записей получено из ЖурналаРегистрации
Процедура ЖРВыгрузкаЖурналаВФоне(СтруктураПараметров, АдресХранилища) Экспорт
	Соединение = Неопределено;
	СтруктураПараметров.Свойство("Соединение", Соединение);
	Если Соединение = Неопределено Тогда
		Соединение = ПодключениеПоУмолчанию();
	КонецЕсли;
	
	Если ПроверкаДатВОтборе(СтруктураПараметров) Тогда
		Результат = ЖРВыгрузкаЖурналаРегистрации(СтруктураПараметров.ДатаНачала, СтруктураПараметров.ДатаОкончания, 0, Соединение);
		ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
	Иначе
		ВызватьИсключение НСтр("ru = 'Некорректно заданы условия отбора журнала регистрации. 
								|Дата начала больше даты окончания.';
								|en = 'Invalid event log filter settings. 
								|The start date is later than the end date.'");
	КонецЕсли;
КонецПроцедуры

// Выгрузка журнала регистрации в фоновом процессе
// Параметры:
//		СтруктураПараметров - Структура:
//								ДатаНачала - 
//								ДатаОкончания - 
//								КоличествоСобытий - Ограничивает число считываемых методом событий журнала. 
//								Если параметр не указан или равен 0 - без ограничения.
//								Если указано конечное число, метод считывает последние в хронологическом порядке события 
//								с учетом установленного отбора в количестве, не превышающем значения параметра. 
//								Соединение - Справочники.ЖРСоединения
// Возвращаемое значение: Структура -
//		ЗаписаноВБД - количество записей успешно внесенных в БД.
//		КоличествоЗаписейВЖурнале - количество записей получено из ЖурналаРегистрации
Функция ЖРВыгрузкаЖурналаРегистрации(ДатаНачала, ДатаОкончания, КоличествоСобытий, Соединение) Экспорт
	
	// Часто из-за огромного размера журнала регистрации, например в  ERP, не хватает оперативы на сервере 
	// чтобы выгрузить его в таблицу значений за сколь-нибудь небольшой период,
	// иногда даже пару дней вызывает коллапс.
	// Поэтому разбиваем загрузку по часам.
	
	СоздатьТаблицыЖРНаСервереБД(Соединение);
	АДОКоманда = АДОКомандаПоУмолчанию(Соединение);
	ТЗПериодов = ЖРСлужебныйСервер.РазбиениеПериодаНаЧасы(ДатаНачала, ДатаОкончания);
	ЗаписаноВБД = 0;
	РазмерПакета = 200;
	КоличествоЗаписейВЖурналеИтого = 0;
	Для Каждого СтрокаПериодов Из ТЗПериодов Цикл	
		Журнал = СобытияЖурналаРегистрации(Новый Структура("ДатаНачала,ДатаОкончания", 
			СтрокаПериодов.НачалоПериода, СтрокаПериодов.КонецПериода), 0);
		КоличествоЗаписейВЖурнале = Журнал.Количество();
		КоличествоЗаписейВЖурналеИтого = КоличествоЗаписейВЖурналеИтого + КоличествоЗаписейВЖурнале;
		ТекущаяЗапись = 0;
		Пакет = Журнал.СкопироватьКолонки();
		Для Каждого Событие Из Журнал Цикл
			ЗаполнитьЗначенияСвойств(Пакет.Добавить(), Событие);
			ТекущаяЗапись = ТекущаяЗапись + 1;
			Если Пакет.Количество() = РазмерПакета ИЛИ ТекущаяЗапись = КоличествоЗаписейВЖурнале Тогда
				АДОКоманда.CommandText = ТекстЗапросаВставкиДанныхЖурнала(Пакет);
				Попытка
		        		АДОКоманда.Execute();
					ЗаписаноВБД = ЗаписаноВБД + Пакет.Количество();
				Исключение
					ЗаписьЖурналаРегистрации("ВыгрузкаЖурналаРегистрации", 
						УровеньЖурналаРегистрации.Ошибка,
						Метаданные.ОбщиеМодули.ЖРОбщегоНазначения, 
						ОписаниеОшибки(),
						АДОКоманда.CommandText
					); 
				КонецПопытки;
				Пакет.Очистить();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Соединение.Close();
	
	Результат = Новый Структура;
	Результат.Вставить("ЗаписаноВБД", ЗаписаноВБД);
	Результат.Вставить("КоличествоЗаписейВЖурнале", КоличествоЗаписейВЖурналеИтого);
	Возврат Результат;
КонецФункции

Процедура ЖРВыгрузкаЖурналаРегистрацииЗаПредДень() Экспорт
	АДОСоединение = ПодключениеПоУмолчанию();
	ДатаНачала = НачалоДня(ТекущаяДатаСеанса() - 86400);
	ДатаОкончания = КонецДня(ТекущаяДатаСеанса() - 86400);
	РезультатВыгрузки = ЖРВыгрузкаЖурналаРегистрации(ДатаНачала, ДатаОкончания, 0, АДОСоединение);
	Комментарий = СтрШаблон("Выгрузка журнала регистрации за период с %1 по %2. Записано в БД - %3, количество записей в журнале - %4",
		Формат(ДатаНачала, "ДФЛ=ДВ"), 
		Формат(ДатаОкончания, "ДФЛ=ДВ"), 
		РезультатВыгрузки.ЗаписаноВБД,
		РезультатВыгрузки.КоличествоЗаписейВЖурнале
	);
	ЗаписьЖурналаРегистрации("ВыгрузкаЖурналаРегистрацииЗаПредДень", 
						УровеньЖурналаРегистрации.Информация,
						Метаданные.ОбщиеМодули.ЖРОбщегоНазначения, 
						Комментарий
					);
КонецПроцедуры

#КонецОбласти

#Область ПолучениеДанных

// Получение данных на сервере Postgres в таблицу значений
// Параметры:
//	Отбор - Структура
//	Соединение - СправочникСсылка.ЖРСоединения, 
//Возвращаемое значение: ТаблицаЗначений из событий
Функция ПолучитьДанныеНаСервере(Отбор, Соединение) Экспорт
	
	ТЗСобытий = Новый ТаблицаЗначений;
	АДОСоединение = ПодключениеПоУмолчанию(Соединение);
	
	АДОНаборЗаписей = АДОРекордСет();
	АДОКоманда = АДОКомандаПоУмолчанию(АДОСоединение);
	АДОКоманда.CommandText = СтрШаблон("SELECT * FROM %1 %2 %3", 
		ИмяТаблицы(), 
		СтрокаУсловияПоУмолчанию(), 
		ОтборВСтрокуУсловия(Отбор)
	);
	Попытка
		АДОНаборЗаписей = АДОКоманда.Execute();
	Исключение
		ЗаписьЖурналаРегистрации("ПолучитьДанныеНаСервере", 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.ОбщиеМодули.ЖРОбщегоНазначения,
			ОписаниеОшибки(),
			АДОКоманда.CommandText
		);
		Возврат Неопределено;
	КонецПопытки;
	Пока АДОНаборЗаписей.EOF = 0 Цикл    // Заполнение созданной таблицы 
		НоваяСтрока = ТЗСобытий.Добавить();
		НоваяСтрока.Id = АДОНаборЗаписей.Fields("Id").Value;
		НоваяСтрока.ИдентификаторИБ = АДОНаборЗаписей.Fields("ИдентификаторИБ").Value;
		НоваяСтрока.Уровень = АДОНаборЗаписей.Fields("Уровень").Value;
		НоваяСтрока.Дата = АДОНаборЗаписей.Fields("Дата").Value;
		НоваяСтрока.Пользователь = АДОНаборЗаписей.Fields("Пользователь").Value;
		НоваяСтрока.ИмяПользователя = АДОНаборЗаписей.Fields("ИмяПользователя").Value;
		НоваяСтрока.Компьютер = АДОНаборЗаписей.Fields("Компьютер").Value;
		НоваяСтрока.ИмяПриложения = АДОНаборЗаписей.Fields("ИмяПриложения").Value;
		НоваяСтрока.Событие = АДОНаборЗаписей.Fields("Событие").Value;
		НоваяСтрока.ПредставлениеСобытия = АДОНаборЗаписей.Fields("ПредставлениеСобытия").Value;
		НоваяСтрока.Комментарий = АДОНаборЗаписей.Fields("Комментарий").Value;
		НоваяСтрока.Метаданные = АДОНаборЗаписей.Fields("Метаданные").Value;
		НоваяСтрока.ПредставлениеМетаданных = АДОНаборЗаписей.Fields("ПредставлениеМетаданных").Value;
		НоваяСтрока.Данные = ЖРСлужебныйСервер.ЗначениеИзСтрокиXML(АДОНаборЗаписей.Fields("Данные").Value);
		НоваяСтрока.ПредставлениеДанных = АДОНаборЗаписей.Fields("ПредставлениеДанных").Value;
		НоваяСтрока.ПредставлениеПриложения = АДОНаборЗаписей.Fields("ПредставлениеПриложения").Value;
		НоваяСтрока.СтатусТранзакции = АДОНаборЗаписей.Fields("СтатусТранзакции").Value;
		НоваяСтрока.Транзакция = АДОНаборЗаписей.Fields("Транзакция").Value;
		НоваяСтрока.Сеанс = АДОНаборЗаписей.Fields("Сеанс").Value;
		НоваяСтрока.Соединение = АДОНаборЗаписей.Fields("Соединение").Value;
		НоваяСтрока.РабочийСервер = АДОНаборЗаписей.Fields("РабочийСервер").Value;
		НоваяСтрока.ОсновнойIPПорт = АДОНаборЗаписей.Fields("ОсновнойIPПорт").Value;
		НоваяСтрока.ВспомогательныйIPПорт = АДОНаборЗаписей.Fields("ВспомогательныйIPПорт").Value;
		Попытка
			НоваяСтрока.РазделениеДанныхСеанса = ЖРСлужебныйСервер.ЗначениеИзСтрокиXML(
				АДОНаборЗаписей.Fields("РазделениеДанныхСеанса").Value);
			НоваяСтрока.ПредставлениеРазделенияДанныхСеанса = АДОНаборЗаписей.Fields(
				"ПредставлениеРазделенияДанныхСеанса").Value;
		Исключение
			НоваяСтрока.РазделениеДанныхСеанса = "";
			НоваяСтрока.ПредставлениеРазделенияДанныхСеанса = "";
		КонецПопытки;
		АДОНаборЗаписей.MoveNext();	
	КонецЦикла;
	АДОНаборЗаписей.Close();
	АДОСоединение.Close();
	
	Возврат ТЗСобытий;
КонецФункции

// Получение данных для формы обработки ЖРЖурналРегистрации
// Параметры:
//	СтруктураПараметров - Структура:
//		Отбор - Структура
//		Соединение - СправочникСсылка.ЖРСоединения
//	АдресХранилища - Строка
Процедура ПолучитьДанныеНаСервереВФоне(СтруктураПараметров, АдресХранилища) Экспорт
	
	Соединение = Неопределено;
	СтруктураПараметров.Свойство("Соединение", Соединение);
	АДОСоединение = ПодключениеПоУмолчанию(Соединение);
	АДОНаборЗаписей = АДОРекордСет();
	АДОКоманда = АДОКомандаПоУмолчанию(АДОСоединение);
	АДОКоманда.CommandText = СтрШаблон("SELECT 
		|	Id,
		|	Уровень,
		|	Дата,
		|	ИмяПользователя,
		|	Компьютер,
		|	ПредставлениеСобытия,
		|	Комментарий,
		|	ПредставлениеМетаданных,
		|	ПредставлениеДанных,
		|	ПредставлениеПриложения,
		|	Сеанс 
		|FROM %1 %2 %3", ИмяТаблицы(), СтрокаУсловияПоУмолчанию(), ОтборВСтрокуУсловия(СтруктураПараметров.Отбор));
	Попытка
		АДОНаборЗаписей = АДОКоманда.Execute();
	Исключение
		ЗаписьЖурналаРегистрации("ПолучитьДанныеНаСервереВФоне", 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.ОбщиеМодули.ЖРОбщегоНазначения,
			ОписаниеОшибки(),
			АДОКоманда.CommandText
		);
		Возврат;
	КонецПопытки;
	ТЗСобытий = Новый ТаблицаЗначений;
	ТЗСобытий.Колонки.Добавить("Id");
	ТЗСобытий.Колонки.Добавить("Уровень");
	ТЗСобытий.Колонки.Добавить("Дата");
	ТЗСобытий.Колонки.Добавить("ИмяПользователя");
	ТЗСобытий.Колонки.Добавить("Компьютер");
	ТЗСобытий.Колонки.Добавить("ПредставлениеСобытия");
	ТЗСобытий.Колонки.Добавить("Комментарий");
	ТЗСобытий.Колонки.Добавить("ПредставлениеМетаданных");
	ТЗСобытий.Колонки.Добавить("ПредставлениеДанных");
	ТЗСобытий.Колонки.Добавить("ПредставлениеПриложения");
	ТЗСобытий.Колонки.Добавить("Сеанс");	
	
	Пока АДОНаборЗаписей.EOF=0 Цикл    // Заполнение созданной таблицы 
		НоваяСтрока = ТЗСобытий.Добавить();
		НоваяСтрока.Id = АДОНаборЗаписей.Fields("Id").Value;
		НоваяСтрока.Уровень = АДОНаборЗаписей.Fields("Уровень").Value;
		НоваяСтрока.Дата = АДОНаборЗаписей.Fields("Дата").Value;
		НоваяСтрока.ИмяПользователя = АДОНаборЗаписей.Fields("ИмяПользователя").Value;
		НоваяСтрока.Компьютер = АДОНаборЗаписей.Fields("Компьютер").Value;
		НоваяСтрока.ПредставлениеСобытия = АДОНаборЗаписей.Fields("ПредставлениеСобытия").Value;
		НоваяСтрока.Комментарий = АДОНаборЗаписей.Fields("Комментарий").Value;
		НоваяСтрока.ПредставлениеМетаданных = АДОНаборЗаписей.Fields("ПредставлениеМетаданных").Value;
		НоваяСтрока.ПредставлениеДанных = АДОНаборЗаписей.Fields("ПредставлениеДанных").Value;
		НоваяСтрока.ПредставлениеПриложения = АДОНаборЗаписей.Fields("ПредставлениеПриложения").Value;
		НоваяСтрока.Сеанс = АДОНаборЗаписей.Fields("Сеанс").Value;
		АДОНаборЗаписей.MoveNext();
		
	КонецЦикла;
	АДОНаборЗаписей.Close();
	АДОСоединение.Close();
	
		// Успешное завершение
	Результат = Новый Структура;
	Результат.Вставить("СобытияЖурнала", ТЗСобытий);
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);

КонецПроцедуры

Процедура ПолучитьЗаписьПоИДНаСервереВФоне(Отбор, АдресХранилища) Экспорт
	
	Ид = Неопределено;
	ИдЗаполнено = Отбор.Свойство("Id", Ид);
	Если Не ИдЗаполнено Тогда
		Результат = Новый Структура;
		Результат.Вставить("ОписаниеОшибки", "Для поиска по идентификатору необходимо передать этот идентификатор!!))");
		ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
		Возврат;
	КонецЕсли;
	Соединение = Неопределено;
	Отбор.Свойство("Соединение", Соединение);
	АДОСоединение = ПодключениеПоУмолчанию(Соединение);
	АДОНаборЗаписей = АДОРекордСет();
	АДОКоманда = АДОКомандаПоУмолчанию(АДОСоединение);
	АДОКоманда.CommandText = СтрШаблон("SELECT * FROM %1 Where Id='%2'", ИмяТаблицы(), Ид);
	Попытка
		АДОНаборЗаписей = АДОКоманда.Execute();
	Исключение
		ЗаписьЖурналаРегистрации("ПолучитьЗаписьПоИДНаСервереВФоне", 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.ОбщиеМодули.ЖРОбщегоНазначения, 
			ОписаниеОшибки(),
			АДОКоманда.CommandText
		);
		Возврат;
	КонецПопытки;

	Попытка
		АДОНаборЗаписей.MoveFirst();
	Исключение
		Результат = Новый Структура;
		Результат.Вставить("ОписаниеОшибки", "Отсутствуют данные по указанному идентификатору!!");
		ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
		Возврат;
	КонецПопытки;
	СтруктураЗапись = Новый Структура;
	СтруктураЗапись.Вставить("Id", АДОНаборЗаписей.Fields("Id").Value);
	СтруктураЗапись.Вставить("ИдентификаторИБ", АДОНаборЗаписей.Fields("ИдентификаторИБ").Value);
	СтруктураЗапись.Вставить("Уровень", АДОНаборЗаписей.Fields("Уровень").Value);
	СтруктураЗапись.Вставить("Дата", АДОНаборЗаписей.Fields("Дата").Value);
	СтруктураЗапись.Вставить("Пользователь", АДОНаборЗаписей.Fields("Пользователь").Value);
	СтруктураЗапись.Вставить("ИмяПользователя", АДОНаборЗаписей.Fields("ИмяПользователя").Value);
	СтруктураЗапись.Вставить("Компьютер", АДОНаборЗаписей.Fields("Компьютер").Value);
